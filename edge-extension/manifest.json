{
  "manifest_version": 3,
  "name": "Dota 2 Live Market Monitor",
  "version": "0.1.0",
  "description": "Passively records sanitized RayBet Dota 2 market events for local shadow analysis.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.ray086.com/*",
    "https://cfinfo.365raylinks.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ray086.com/*"],
      "js": ["src/main-hook.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.ray086.com/*"],
      "js": [
        "src/constants.js",
        "src/canonical-json.js",
        "src/redact.js",
        "src/classify.js",
        "src/content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Dota 2 live monitor",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765"
  }
}
